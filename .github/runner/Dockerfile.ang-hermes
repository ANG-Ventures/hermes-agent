# ANG-Ventures fork runner image: heavy base + everything the hermes-agent CI matrix
# needs that GitHub-hosted ubuntu-latest ships but a locked-down container runner
# (RUN_AS_ROOT=false, NoNewPrivileges) cannot sudo-install at job time.
#
# Layers on top of ci-runner-heavy:node20 (node20/npm/lsof/pulse) with:
#   - Electron/Playwright system deps (e2e-desktop.yml's exact apt list + xvfb)
#   - gitleaks (fleet-secret-scan.yml — job-time install now targets ~/.local/bin,
#     but pre-baking removes the network fetch)
#   - ripgrep (tests.yml)
#   - hadolint static binary (docker.yml lints Dockerfiles via container action on
#     hosted runners; on self-hosted there is no docker socket, so the binary must
#     be on PATH)
#
# Build (on ACE-AI):
#   sudo docker build -f /opt/ci-runners/Dockerfile.ang-hermes -t ci-runner-ang-hermes:1 /opt/ci-runners
# Wire (systemd drop-in for the ANG pool):
#   /etc/systemd/system/ci-runner-pool@ang-hermes-agent.service.d/20-ang-image.conf
#     [Service]
#     Environment=CI_RUNNER_IMAGE=ci-runner-ang-hermes:1
#   sudo systemctl daemon-reload && sudo systemctl restart ci-runner-pool@ang-hermes-agent
FROM ci-runner-heavy:node20

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      xvfb \
      libgtk-3-0 libnotify4 libnss3 libxss1 libxtst6 \
      xdg-utils libatspi2.0-0 libdrm2 libgbm1 libasound2t64 \
      ripgrep \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy .github/scripts/install-ci-tool.sh from the reviewed repository into
# the build context. Jobs and images share the architecture/checksum map.
COPY install-ci-tool.sh /tmp/install-ci-tool.sh
RUN bash /tmp/install-ci-tool.sh gitleaks /usr/local/bin \
 && bash /tmp/install-ci-tool.sh hadolint /usr/local/bin \
 && rm /tmp/install-ci-tool.sh

RUN rg --version && node --version
